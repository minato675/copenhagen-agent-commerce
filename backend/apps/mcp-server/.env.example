# Server deployment template, not the local QA tunnel configuration.
# Spring Boot does not load this file automatically. Inject as container environment.
# Fill the agreed auth settings and implement McpTokenVerifier before enabling deployment.
SPRING_PROFILES_ACTIVE=deployment
CORE_SERVICE_URL=http://core-service:8080
CORE_CONNECT_TIMEOUT=2s
CORE_REQUEST_TIMEOUT=5s
CORE_MAX_RESPONSE_BYTES=262144
MCP_REQUEST_TIMEOUT=10s
MCP_MAX_REQUEST_BYTES=262144

# Required: exact issuer, public HTTPS /mcp resource, comma-separated agreed scopes.
MCP_AUTH_ISSUER=
MCP_AUTH_RESOURCE=
MCP_AUTH_REQUIRED_SCOPES=
# Required: explicit hosts (host[:port]) and origins (scheme://host[:port]).
# Use the Host that the reverse proxy actually forwards. Avoid broad wildcards.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

# Enable only after the corresponding Core adapters and scopes are configured.
MCP_UI_ENABLED=false
MCP_MERCHANTS_ENABLED=false
MCP_MERCHANTS_REQUIRED_SCOPES=
MCP_CATALOG_ENABLED=false
MCP_CATALOG_DETAIL_ENABLED=false
MCP_CATALOG_REQUIRED_SCOPES=
MCP_CART_ENABLED=false
MCP_CART_READ_SCOPES=
MCP_CART_WRITE_SCOPES=
MCP_HANDOFF_ENABLED=false
MCP_HANDOFF_WRITE_SCOPES=
MCP_HANDOFF_LINK_BASE=
