# 직접 Spring 실행용. Compose는 infra/docker/ec2.env.example의 MCP_SPRING_PROFILES_ACTIVE를 사용한다.
# 인프라의 컨테이너 환경변수/비밀파일 설정에 전달한다. Spring은 이 파일을 자동으로 읽지 않는다.
SPRING_PROFILES_ACTIVE=core-integration
CORE_SERVICE_URL=http://core-service:8080
MCP_AUTH_RESOURCE=https://j15a207.p.ssafy.io/mcp
# Core OAuth(337)와 동일 호스트에 배포할 때의 공개 주소.
MCP_AUTH_ISSUER=https://j15a207.p.ssafy.io
MCP_AUTH_JWKS_URI=https://j15a207.p.ssafy.io/.well-known/jwks.json
CORE_TOKEN_URI=https://j15a207.p.ssafy.io/oauth/token
CORE_MCP_CLIENT_ID=copenhagen-mcp
# RSA(2048비트 이상) 또는 P-256 EC 개인 JWK. kid 필수. 대응 공개 JWK는 Core에 등록한다.
CORE_MCP_PRIVATE_JWK_FILE=/run/secrets/mcp/client.jwk
MCP_ALLOWED_HOSTS=j15a207.p.ssafy.io,mcp-server:8080,localhost:8080
MCP_ALLOWED_ORIGINS=https://chatgpt.com
