# 개발 EC2에서 이 파일을 <DEV_DEPLOY_PATH>/.env로 복사합니다.
# 실제 값을 채운 .env 파일은 절대 commit하지 않습니다.

NGINX_PORT=80

CORE_DB_USER=core
CORE_DB_PASSWORD=CHANGE_ME
PAY_DB_USER=pay
PAY_DB_PASSWORD=CHANGE_ME
MERCHANT_DB_USER=merchant
MERCHANT_DB_PASSWORD=CHANGE_ME

# Pay authentication values must be supplied through the private .env or a Secret manager.
# Each JSON object maps a principal subject to its opaque token.
# PAY_AUTH_USER_TOKENS_JSON={"user-001":"<opaque-user-token>"}
# PAY_AUTH_CORE_SERVICE_TOKENS_JSON={"core-service":"<core-service-token>"}
# PAY_AUTH_MERCHANT_SERVICE_TOKENS_JSON={"merchant-001":"<merchant-service-token>"}
# PAY_AUTH_JWT_ENABLED=false
# PAY_AUTH_JWT_ISSUER=https://core.example.com
# PAY_AUTH_JWT_AUDIENCE=pay-service
# PAY_AUTH_JWT_JWK_SET_JSON=<core-public-jwk-set-json>
# PAY_AUTH_JWT_CLOCK_SKEW_SECONDS=60

# 아래 image 값은 CI 배포 job이 EC2에 직접 적재한 뒤 자동으로 기록합니다.
# CORE_IMAGE=copenhagen/core-service:<commit-sha>
# MCP_IMAGE=copenhagen/mcp-server:<commit-sha>
# PAY_IMAGE=copenhagen/pay-service:<commit-sha>
# MERCHANT_MOCK_IMAGE=copenhagen/ucp-merchant-mock:<commit-sha>
# PG_MOCK_IMAGE=copenhagen/pg-mock:<commit-sha>

# MCP/Core OAuth 연결. 준비 순서는 mcp-oauth-deployment.md 참고.
# 아래 공개 주소에는 끝의 /를 추가하지 않습니다.
AGENT_OAUTH_ISSUER=https://j15a207.p.ssafy.io
AGENT_OAUTH_MCP_AUDIENCE=https://j15a207.p.ssafy.io/mcp
# Core 전용 P-256 PKCS#8 DER Base64URL 개인키. 운영에서 반드시 채웁니다.
AGENT_OAUTH_JWT_PRIVATE_KEY=
AGENT_OAUTH_JWT_KEY_ID=agent-oauth-server-v1

# 계정 연결만 먼저 검증: issuer/JWKS/callback 준비 후 oauth-registration.
# 업무 API·서비스 키가 준비되면 core-integration으로 전환합니다(둘 중 하나만 지정).
MCP_SPRING_PROFILES_ACTIVE=
MCP_AUTH_RESOURCE=https://j15a207.p.ssafy.io/mcp
MCP_AUTH_ISSUER=https://j15a207.p.ssafy.io
MCP_AUTH_JWKS_URI=https://j15a207.p.ssafy.io/.well-known/jwks.json
CORE_TOKEN_URI=https://j15a207.p.ssafy.io/oauth/token
CORE_MCP_CLIENT_ID=copenhagen-mcp
# 서버의 MCP 전용 비밀 디렉터리 절대경로. client.jwk 파일을 배치합니다.
MCP_SECRETS_DIR=
MCP_ALLOWED_HOSTS=j15a207.p.ssafy.io,mcp-server:8080,localhost:8080
MCP_ALLOWED_ORIGINS=https://chatgpt.com

# 구매 검증·승인 생성 복구·결제 완료 조회 worker
CORE_PAYMENT_WORKER_ENABLED=true
CORE_PAYMENT_WORKER_POLL_INTERVAL_SECONDS=3
# Pay 승인 세션 스키마 이관 드레인 구간에만 true (S15P21A207-486). 켜면 새 구매 검증이 merchant checkout을
# 만들기 전에 503 PURCHASE_SUSPENDED로 반려된다. worker는 위 CORE_PAYMENT_WORKER_ENABLED=false로 함께 내린다.
# 인계 TTL이 30분이라 드레인 창은 그보다 짧아야 한다.
CORE_PURCHASE_APPROVAL_SUSPENDED=false
# Merchant -> Pay 인증. PAY_AUTH_MERCHANT_SERVICE_TOKENS_JSON과 같은 merchantId -> token 매핑.
PAY_MERCHANT_TOKENS_JSON=
# 단일 판매처 개발 환경의 fallback. 다중 판매처 배포는 위 JSON 매핑을 사용.
PAY_MERCHANT_TOKEN=
# 실제 Firebase 설정은 배포 비밀정보에서 주입. 꺼져 있으면 알림 실패 상태로 표시.
PAY_FCM_ENABLED=false
PAY_FCM_PROJECT_ID=
PAY_FCM_SERVICE_ACCOUNT_JSON=
PAY_NOTIFICATION_WORKER_ENABLED=true
PAY_NOTIFICATION_POLL_MILLIS=5000
PAY_NOTIFICATION_BATCH_SIZE=10
PAY_NOTIFICATION_LEASE_SECONDS=60
PAY_NOTIFICATION_RETRY_SECONDS=60
