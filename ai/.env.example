# Reference only: load_settings reads process environment variables, not this file.
FDS_MODE=MOCK
FDS_OPENAI_MODEL=gpt-5.4-mini

# GMS OpenAI base URL: https://gms.ssafy.io/gmsapi/api.openai.com/v1
# Chat Completions uses /chat/completions and Authorization: Bearer GMS_KEY.
# Leave blank for MOCK. Supply real keys through the runtime secret mechanism.
GMS_KEY=

# Timeouts in seconds.
FDS_OPENAI_TIMEOUT_SECONDS=
FDS_EVALUATION_TIMEOUT_SECONDS=

# Version of the configured FDS policy.
FDS_POLICY_VERSION=
